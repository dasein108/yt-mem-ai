# Webshare rotating residential proxy.
# Leave YT_USE_WEBSHARE=false if you already run a system-level proxy/VPN (e.g.
# VLESS/Xray): stacking Webshare on top breaks the authenticated subscription
# feed (its CONNECT tunnel returns 405). Set true only if you have no other
# proxy and YouTube rate-limits your raw IP.
YT_USE_WEBSHARE=false
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Browser to pull cookies from (chrome|brave|edge|firefox); blank = none
YT_COOKIES_BROWSER=chrome
# Storage
YT_DOWNLOADS_DIR=downloads
# Preferred caption languages (comma-separated, priority order). Tried first, then
# any available track is used — so non-English videos ingest without whisper.
YT_CAPTION_LANGS=en
# faster-whisper
YT_WHISPER_MODEL=small
YT_WHISPER_DEVICE=cpu
YT_WHISPER_COMPUTE_TYPE=int8
# Optional LLM (SP0 unused; automation path)
OPENROUTER_API_KEY=
# LanceDB store directory
YT_STORE_PATH=yt_lance
# Embeddings: local (sentence-transformers) or openai
YT_EMBEDDING_BACKEND=local
YT_EMBEDDING_MODEL=
# Transcript chunk target length (seconds)
YT_CHUNK_TARGET_S=45
# OpenAI (used when YT_EMBEDDING_BACKEND=openai)
OPENAI_API_KEY=
# HuggingFace token (higher rate limits for local sentence-transformers)
HF_TOKEN=
# discover: per-extraction timeout (s) — fails fast instead of hanging on a Chrome Keychain prompt
YT_DISCOVER_TIMEOUT_S=30
# discover: cap newest feed entries pulled per run (feed is newest-first; avoids
# paginating the entire subscription history)
YT_DISCOVER_FEED_LIMIT=60
# discover: incremental re-fetch overlap (s) before the last high-water mark.
# approximate_date timestamps are hour-rounded, so 1h avoids missing a boundary
# video; the DB dedupes the re-seen ones.
YT_DISCOVER_OVERLAP_S=3600
